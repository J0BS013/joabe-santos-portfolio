---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy } from '../data/site';
import { withBase, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const publicVersionLabel = locale === 'en' ? 'Public version' : locale === 'pt-br' ? 'Versão pública' : 'Versión pública';
const publicVersionNote = locale === 'en'
  ? 'Prepared for public distribution, with the professional record, education and contact links preserved while phone details and confidential client identification are omitted.'
  : locale === 'pt-br'
    ? 'Preparada para distribuição pública, mantendo a trajetória profissional, a formação e os links de contato, sem telefone ou identificação confidencial do cliente.'
    : 'Preparada para distribución pública, manteniendo la trayectoria profesional, la formación y los enlaces de contacto, sin teléfono ni identificación confidencial del cliente.';
---
<BaseLayout locale={locale} routePath="/resume" title={`${t.resumeTitle} — Joabe Santos`} description={t.resumeBody}>
  <main class="resume-page">
    <div class="container resume-shell">
      <div class="resume-main">
        <p class="eyebrow">PDF · 2 pages</p>
        <h1>{t.resumeTitle}</h1>
        <p class="lede">{t.resumeBody}</p>
        <div class="button-row">
          <a class="button" href={withBase('/resume/joabe-santos-resume.pdf')} download>{t.resumeDownload}</a>
          <a class="button secondary" href="mailto:jbencao37@gmail.com">Email</a>
        </div>
        <p class="resume-updated">{t.updated}</p>
      </div>
      <aside class="resume-note">
        <p class="eyebrow">{publicVersionLabel}</p>
        <p>{publicVersionNote}</p>
      </aside>
    </div>
  </main>
</BaseLayout>
