---
import { localeLabels, locales, localizedPath, type Locale } from '../lib/i18n';

interface Props { locale: Locale; routePath: string; }
const { locale, routePath } = Astro.props;
const navigationLabel = locale === 'en' ? 'Language' : locale === 'pt-br' ? 'Idioma' : 'Idioma';
---

<nav class="language-switcher" aria-label={navigationLabel}>
  {locales.map((item) => (
    <a
      href={localizedPath(item, routePath)}
      aria-current={item === locale ? 'page' : undefined}
      lang={item === 'pt-br' ? 'pt-BR' : item}
    >{localeLabels[item]}</a>
  ))}
</nav>

<style>
  .language-switcher { align-items: center; display: flex; gap: 0.2rem; }
  a, a:hover, a:focus, a:visited { border-bottom: 0 !important; color: var(--muted); font-family: var(--mono); font-size: 0.76rem; font-weight: 700; padding: .3rem .48rem; text-decoration: none !important; }
  a[aria-current='page'] { background: #f1e7df; border-radius: 999px; color: var(--accent-dark); text-decoration: none !important; }
</style>
