---
import type { Locale } from '../lib/i18n';
import { withBase } from '../lib/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const text = locale === 'en'
  ? {
      alt: 'Joabe Santos smiling in front of a yellow and black mural.',
      caption: 'Decision science, analytics engineering and business action.',
      data: 'Trusted data',
      decision: 'Decision → action',
    }
  : locale === 'pt-br'
    ? {
        alt: 'Joabe Santos sorrindo diante de um mural amarelo e preto.',
        caption: 'Decision science, analytics engineering e ação de negócio.',
        data: 'Dados confiáveis',
        decision: 'Decisão → ação',
      }
    : {
        alt: 'Joabe Santos sonriendo frente a un mural amarillo y negro.',
        caption: 'Decision science, analytics engineering y acción de negocio.',
        data: 'Datos confiables',
        decision: 'Decisión → acción',
      };
---

<figure class="portrait">
  <div class="portrait-frame">
    <img
      src={withBase('/images/joabe-santos-portrait.jpg')}
      alt={text.alt}
      width="1200"
      height="1200"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="data-grid" aria-hidden="true"></div>
    <span class="signal signal-data"><i></i>{text.data}</span>
    <span class="signal signal-decision"><i></i>{text.decision}</span>
  </div>
  <figcaption>{text.caption}</figcaption>
</figure>

<style>
  .portrait { margin: 0; }
  .portrait-frame { aspect-ratio: 1; background: var(--green); border-radius: 2rem; box-shadow: 0 24px 50px rgba(19,45,36,.18); overflow: hidden; position: relative; }
  img { height: 100%; object-fit: cover; object-position: center; width: 100%; }
  .data-grid { background-image: linear-gradient(rgba(255,255,255,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.14) 1px, transparent 1px); background-size: 4rem 4rem; inset: 0; mask-image: linear-gradient(135deg, transparent 40%, black); position: absolute; }
  .signal { align-items: center; backdrop-filter: blur(12px); background: rgba(247,247,242,.92); border: 1px solid rgba(20,32,27,.14); border-radius: 999px; color: var(--ink); display: flex; font-family: var(--mono); font-size: .7rem; font-weight: 700; gap: .55rem; letter-spacing: .04em; padding: .65rem .9rem; position: absolute; text-transform: uppercase; }
  .signal i { background: var(--accent); border-radius: 50%; height: .55rem; width: .55rem; }
  .signal-data { right: 1.1rem; top: 1.1rem; }
  .signal-decision { bottom: 1.1rem; left: 1.1rem; }
  figcaption { color: var(--muted); font-family: var(--mono); font-size: .7rem; margin-top: .75rem; }
  @media (max-width: 38rem) {
    .portrait-frame { border-radius: 1.35rem; }
    .signal { font-size: .62rem; }
  }
</style>
